{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/faculty",
      "destination": "/fac.html"
    },
    {
      "source": "/waiting",
      "destination": "/raniwaitingpage.html"
    },
    {
      "source": "/test",
      "destination": "/test.html"
    }
  ]
}
